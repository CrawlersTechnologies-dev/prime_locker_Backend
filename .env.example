# Django Core
SECRET_KEY=your-django-secret-key-here
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Database (PostgreSQL / SQLite)
# DB_NAME=prime_locker_db
# DB_USER=postgres
# DB_PASSWORD=your_password
# DB_HOST=127.0.0.1
# DB_PORT=5432

# -------------------------------------------------------------
# Third-Party Device MDM Integration (Apple DEP / Supervised)
# -------------------------------------------------------------
# Base URL of Apple MDM Gateway (e.g. MicroMDM or third-party MDM provider)
APPLE_MDM_BASE_URL=https://mdm.your-server.com/api/v1
# API Key / Bearer Token for Apple MDM Gateway
APPLE_MDM_API_KEY=your_apple_mdm_api_key_here
# Apple Business Manager (ABM) / DEP Organization Tenant ID
APPLE_MDM_TENANT_ID=your_dep_tenant_id_here

# -------------------------------------------------------------
# Optional: Firebase Cloud Messaging (FCM) for Instant Android Push
# -------------------------------------------------------------
FCM_SERVER_KEY=your_fcm_server_key_here

# -------------------------------------------------------------
# Optional: SMS / WhatsApp Reminders Gateway
# -------------------------------------------------------------
SMS_GATEWAY_URL=https://api.sms-provider.com/send
SMS_GATEWAY_KEY=your_sms_gateway_key_here

# -------------------------------------------------------------
# Online Payment Gateway (Cashfree PG v2023-08-01)
# -------------------------------------------------------------
# Sandbox / Test Credentials (obtain from Cashfree Merchant Sandbox Dashboard)
CASHFREE_APP_ID=your_cashfree_app_id_here
CASHFREE_SECRET_KEY=your_cashfree_secret_key_here
CASHFREE_API_VERSION=2023-08-01
# For Test/Sandbox: https://sandbox.cashfree.com/pg | For Production: https://api.cashfree.com/pg
CASHFREE_BASE_URL=https://sandbox.cashfree.com/pg
# Environment: TEST or PROD
CASHFREE_ENV=TEST

# -------------------------------------------------------------
# Online Payment Gateway (Razorpay)
# -------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

