  "item": [
    {
      "name": "1. Authentication & Live DLT SMS",
      "item": [
        {
          "name": "1.1 Login (Obtain JWT Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.access) {",
                  "    pm.collectionVariables.set('access_token', jsonData.access);",
                  "    console.log('Access token set successfully');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"superadmin\",\n    \"password\": \"Admin@123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "login",
                ""
              ]
            },
            "description": "Authenticates user and auto-saves the JWT access token in the collection variable {{access_token}}."
          },
          "response": []
        },
        {
          "name": "1.2 Request MPIN Reset OTP (Live Jio DLT SMS)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"mobile_number\": \"{{mobile_number}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/mpin/request-otp/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "mpin",
                "request-otp",
                ""
              ]
            },
            "description": "Dispatches live DLT OTP SMS via APITxT using Header PRLOCK, Template ID 1277179438043729654, Entity ID 1201179275669531017, and Telemarketer ID 1202162934973074727."
          },
          "response": []
        },
        {
          "name": "1.3 Verify MPIN Reset OTP & Set New MPIN",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"mobile_number\": \"{{mobile_number}}\",\n    \"otp\": \"{{otp_code}}\",\n    \"new_mpin\": \"123456\",\n    \"confirm_mpin\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/mpin/verify-otp/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "mpin",
                "verify-otp",
                ""
              ]
            },
            "description": "Verifies the 6-digit OTP received on mobile and updates user MPIN."
          },
          "response": []
        },
        {
          "name": "1.4 Request Password Reset OTP (Live Jio DLT SMS)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"identifier\": \"{{mobile_number}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/password-reset/request-otp/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "password-reset",
                "request-otp",
                ""
              ]
            },
            "description": "Sends live password reset OTP SMS via Jio DLT PRLOCK route."
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. EMI Loan Agreement (New Features)",
      "item": [
        {
          "name": "2.1 View Agreement HTML (Webview / Print Preview)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "text/html"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/emi-contracts/{{contract_id}}/agreement/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "emi-contracts",
                "{{contract_id}}",
                "agreement",
                ""
              ]
            },
            "description": "Returns responsive, table-free, 1-page A4 legal agreement HTML view. Features contracting parties, collateral IMEI, repayment terms, covenants, and sole borrower digital signature. Includes print button (window.print()) and PDF download link."
          },
          "response": []
        },
        {
          "name": "2.2 Download Agreement PDF (Action Endpoint)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/emi-contracts/{{contract_id}}/agreement-pdf/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "emi-contracts",
                "{{contract_id}}",
                "agreement-pdf",
                ""
              ]
            },
            "description": "Directly streams and downloads a 1-page A4 legal agreement PDF binary generated via ReportLab (Content-Type: application/pdf)."
          },
          "response": []
        },
        {
          "name": "2.3 Download Agreement PDF (Query Param ?download=pdf)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/emi-contracts/{{contract_id}}/agreement/?download=pdf",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "emi-contracts",
                "{{contract_id}}",
                "agreement",
                ""
              ],
              "query": [
                {
                  "key": "download",
                  "value": "pdf"
                }
              ]
            },
            "description": "Downloads the compiled 1-page A4 PDF binary using the ?download=pdf query parameter on the base agreement URL."
          },
          "response": []
        },
        {
          "name": "2.4 Get Agreement Raw JSON Data (?format=json)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/emi-contracts/{{contract_id}}/agreement/?format=json",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "emi-contracts",
                "{{contract_id}}",
                "agreement",
                ""
              ],
              "query": [
                {
                  "key": "format",
                  "value": "json"
                }
              ]
            },
            "description": "Returns structured JSON data payload of the agreement: agreement_number, status, retailer, customer (including signature_url), financed_product, collateral_device, and financial_terms."
          },
          "response": []
        },
        {
          "name": "2.5 List EMI Contracts (Includes agreement_url)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/emi-contracts/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "emi-contracts",
                ""
              ]
            },
            "description": "Lists all EMI contracts accessible to the logged in user. Each record exposes agreement_url in addition to mandate_auth_url."
          },
          "response": []
        },
        {
          "name": "2.6 Get EMI Contract Details",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/emi-contracts/{{contract_id}}/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "emi-contracts",
                "{{contract_id}}",
                ""
              ]
            },
            "description": "Retrieves contract record by ID, showing customer details, installments breakdown, mandate status, and agreement_url."
          },
          "response": []
        }
      ]
    },
    {
      "name": "3. Device Locking & Payment Operations",
      "item": [
        {
          "name": "3.1 Manual Device Lock",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"reason\": \"Manual lock due to overdue payment\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/emi-contracts/{{contract_id}}/lock/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "emi-contracts",
                "{{contract_id}}",
                "lock",
                ""
              ]
            },
            "description": "Manually triggers a device lock command on the contract's collateral handset (accessible by Retailer / Staff / Admin)."
          },
          "response": []
        },
        {
          "name": "3.2 Manual Device Unlock",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"reason\": \"Payment received in store cash\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/emi-contracts/{{contract_id}}/unlock/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "emi-contracts",
                "{{contract_id}}",
                "unlock",
                ""
              ]
            },
            "description": "Manually triggers a device unlock command and restores active status."
          },
          "response": []
        },
        {
          "name": "3.3 Record Installment Payment (Cash / UPI)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"amount_paid\": \"1500.00\",\n    \"payment_mode\": \"CASH\",\n    \"transaction_reference\": \"TXN_CASH_1001\",\n    \"notes\": \"Payment recorded at retail counter\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/emi-installments/{{installment_id}}/record-payment/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "emi-installments",
                "{{installment_id}}",
                "record-payment",
                ""
              ]
            },
            "description": "Records an installment payment, updates status to PAID, and automatically unlocks the device if overdue."
          },
          "response": []
        }
      ]
    },
    {
      "name": "4. Customer Documents & Photo Edit (Admin)",
      "item": [
        {
          "name": "4.1 Edit Customer Photo (Multipart File Upload)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "customer_photo",
                  "type": "file",
                  "description": "Select new customer selfie/photo file (JPG, PNG, WEBP)"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/api/customers/{{customer_id}}/edit-photo/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "customers",
                "{{customer_id}}",
                "edit-photo",
                ""
              ]
            },
            "description": "Super Admin or authorized manager uploads or replaces customer KYC photo. Permitted at any time, even after device activation."
          }
        },
        {
          "name": "4.2 Edit Customer Photo (Base64 JSON)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer_photo\": \"data:image/jpeg;base64,/9j/4AAQSkZJRgABAQEASABIAAD...\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/customers/{{customer_id}}/edit-photo/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "customers",
                "{{customer_id}}",
                "edit-photo",
                ""
              ]
            },
            "description": "Alternative photo upload endpoint accepting base64 encoded image string directly from mobile apps."
          }
        },
        {
          "name": "4.3 Delete Customer Photo (Clear KYC Photo)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/customers/{{customer_id}}/edit-photo/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "customers",
                "{{customer_id}}",
                "edit-photo",
                ""
              ]
            },
            "description": "Removes customer photo file from storage and sets customer_photo to null."
          }
        },
        {
          "name": "4.4 View Customer Profile & Documents Trio (Admin)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/customers/{{customer_id}}/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "customers",
                "{{customer_id}}",
                ""
              ]
            },
            "description": "Fetches customer details including the documents block with direct links to photo, digital signature, and auto-generated EMI agreement."
          }
        }
      ]
    },
    {
      "name": "5. SIM Card Information & Anti-Fraud (Admin & Retailer)",
      "item": [
        {
          "name": "5.1 Get Device Details (Includes Structured sim_details)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/devices/{{device_id}}/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "devices",
                "{{device_id}}",
                ""
              ]
            },
            "description": "Returns device details including structured sim_details (slot_1, slot_2, is_dual_sim, sim_changed alert flag, and sim_history timeline)."
          }
        },
        {
          "name": "5.2 Heartbeat Telemetry Ping (Simulate SIM & Location Report)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"imei\": \"867530900000001\",\n  \"battery_level\": 92,\n  \"sim_operator\": \"Airtel 5G\",\n  \"sim_number\": \"+919876543210\",\n  \"sim_serial\": \"8991000123456789012F\",\n  \"sim_operator_2\": \"Jio True 5G\",\n  \"sim_number_2\": \"+919812345678\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/devices/ping/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "devices",
                "ping",
                ""
              ]
            },
            "description": "Heartbeat ping API called periodically by the phone app to report SIM info, battery, and location. If SIM ICCID changes, backend automatically flags sim_changed=True and logs to sim_history."
          }
        },
        {
          "name": "5.3 Acknowledge / Clear SIM Change Alert",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/devices/{{device_id}}/acknowledge-sim-change/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "devices",
                "{{device_id}}",
                "acknowledge-sim-change",
                ""
              ]
            },
            "description": "Admin or Retailer clears the red warning badge after verifying an authorized SIM change with the customer."
          }
        }
      ]
    },
    {
      "name": "6. Key Ledger & Whole-Count Transfers (Screen N-07)",
      "item": [
        {
          "name": "6.1 Key Transactions Ledger (Grouped Whole Count - Default)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/keys/transactions/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "keys",
                "transactions",
                ""
              ]
            },
            "description": "Screen N-07: Key history ledger grouped by batch. Displays whole count (e.g. quantity: 50, key_string: DLC-1001 (+49 more)) instead of spamming 50 individual +1 rows."
          }
        },
        {
          "name": "6.2 Key Transactions Ledger (Detailed Raw View)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/keys/transactions/?view=detailed",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "keys",
                "transactions",
                ""
              ],
              "query": [
                {
                  "key": "view",
                  "value": "detailed",
                  "description": "Return individual single-key rows"
                }
              ]
            },
            "description": "Returns individual serial key transaction rows (each with quantity: 1) when individual serial inspection is needed."
          }
        },
        {
          "name": "6.3 Key Transactions CSV Export",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/keys/transactions/?export=csv",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "keys",
                "transactions",
                ""
              ],
              "query": [
                {
                  "key": "export",
                  "value": "csv",
                  "description": "Export ledger to CSV with Quantity column"
                }
              ]
            },
            "description": "Downloads CSV report of key transactions including Quantity and Batch ID columns."
          }
        }
      ]
    }
  ]
}