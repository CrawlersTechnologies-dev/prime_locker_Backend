    {
      "name": "Key Actions",
      "item": [
        {
          "name": "apply key control",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "x-token",
                "value": "{{your_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{key_merchant_service}}/keys/{{key_id}}/control/:control_name/apply/:action_name",
              "host": [
                "{{key_merchant_service}}"
              ],
              "path": [
                "keys",
                "{{key_id}}",
                "control",
                ":control_name",
                "apply",
                ":action_name"
              ],
              "variable": [
                {
                  "key": "control_name",
                  "value": "LOCK"
                },
                {
                  "key": "action_name",
                  "value": "LOCK"
                }
              ]
            }
          },
          "response": []
        },
