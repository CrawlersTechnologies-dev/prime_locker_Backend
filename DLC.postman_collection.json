          "name": "create DLC super-key",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-token",
                "value": "{{your_token}}",
                "type": "text"
              },
              {
                "key": "",
                "value": "{{my_auth_token}}",
                "type": "text",
                "disabled": true
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"device_info\": {\n        \"imei_no\": \"358247910634182\",\n        \"imei_no2\": \"358247915320480\",\n        \"manufacturer\": \"INFINIX\",\n        \"model\": \"Infinix X6730\",\n        \"mdm_type\": \"DLC\" // mandatory, otherwise key will created with DPC\n    },\n    \"is_auto_reminder_enabled\": false,\n    \"mobile_number\": \"+919550369999\",\n    \"name\": \"vinay dlc\"\n}",
