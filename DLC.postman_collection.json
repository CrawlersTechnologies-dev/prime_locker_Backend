  "item": [
    {
      "name": "device catalouge",
      "item": [
        {
          "name": "Get catalogue by imei",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-token",
                "value": "{{your_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{key_merchant_service}}/keys/device-catalogue?imei={{device_id}}",
              "host": [
                "{{key_merchant_service}}"
              ],
              "path": [
                "keys",
                "device-catalogue"
              ],
              "query": [
                {
                  "key": "imei",
                  "value": "{{device_id}}"
                }
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "super-key",
      "item": [
